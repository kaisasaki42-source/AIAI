# =============================================
# X (Twitter) ログイン情報
# =============================================
X_USERNAME=あなたのXのユーザー名またはメールアドレス
X_PASSWORD=あなたのXのパスワード

# =============================================
# Claude (Anthropic) API 認証情報
# https://console.anthropic.com で取得
# =============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================
# 投稿設定
# =============================================
# 投稿テーマ（AIコンテンツ生成時に使用）
POST_TOPIC=テクノロジーとAIの最新情報

# 投稿スケジュール（cron形式）
# 例: "0 9,18 * * *" = 毎日9時と18時
POST_SCHEDULE=0 9,18 * * *

# タイムゾーン
TIMEZONE=Asia/Tokyo

# ブラウザをバックグラウンドで実行するか（true=非表示 / false=画面表示）
HEADLESS=true

# ドライランモード（trueにすると実際には投稿しない）
DRY_RUN=false
