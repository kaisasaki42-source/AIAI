# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Meta Threads API (via Instagram Graph API)
THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret
THREADS_ACCESS_TOKEN=your_long_lived_access_token
THREADS_USER_ID=your_threads_user_id

# Database
DATABASE_URL=postgresql+asyncpg://aiai:aiai_secret@localhost:5432/aiai
POSTGRES_PASSWORD=aiai_secret

# Redis
REDIS_URL=redis://localhost:6379/0

# App Settings
APP_ENV=development
LOG_LEVEL=INFO

# Claude Model
CLAUDE_MODEL=claude-sonnet-4-6

# Posting defaults
DEFAULT_POST_LANGUAGE=ja
MAX_POST_LENGTH=500
